# ============================================================
# «Я Больше!» — пример конфигурации. Скопируйте в .env и заполните.
#   cp .env.example .env
# НИКОГДА не публикуйте .env и не вставляйте ключи в чат/код.
# ============================================================

# --- Локальная расшифровка ---
# Parakeet работает основной моделью, faster-whisper — резервной.
# Обе модели находятся внутри сервера; ключ и плата за минуты не нужны.
LOCAL_PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3:q8_0:cpu
PARAKEET_THREADS=8
LOCAL_WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=1
WHISPER_BATCH_SIZE=8

# --- OpenAI (необязательно, используется только для анализа текста) ---
# Без ключа расшифровка остаётся реальной, а анализ работает в демо-режиме.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_WHISPER_MODEL=whisper-1
# При необходимости другой OpenAI-совместимый endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- База данных (в docker-compose подставляется автоматически) ---
# Для ручного запуска вне Docker:
# DATABASE_URL=mysql://yabolshe:пароль@127.0.0.1:3306/yabolshe
DB_PASSWORD=generate-a-long-random-password
DB_ROOT_PASSWORD=generate-another-long-random-password

# --- Платформенные плейсхолдеры (не используются кодом, оставьте как есть) ---
APP_ID=local
APP_SECRET=generate-a-long-random-secret

# --- Прочее ---
MAX_UPLOAD_MB=500
# false = do not retain the verbatim transcript after drafts are produced
STORE_TRANSCRIPT=false
# Пароль демо-аккаунтов при первом запуске (seed выполняется один раз):
SEED_DEMO_PASSWORD=choose-a-strong-demo-password
# true — cookie только по HTTPS (для домена с TLS оставьте true)
COOKIE_SECURE=true

# Домен без https://, например: yabolshe.ru
DOMAIN=your-domain.ru
